generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Dog {
  id             String    @id @default(cuid())
  registeredName String
  callName       String
  sex            String // MALE | FEMALE
  breed          String
  dateOfBirth    DateTime?
  status         String    @default("ACTIVE") // ACTIVE | RETIRED | DECEASED | SOLD
  microchip      String?
  registration   String?
  photoPath      String?
  notes          String?
  motherId       String?
  fatherId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  mother           Dog?           @relation("MotherOffspring", fields: [motherId], references: [id], onDelete: SetNull)
  father           Dog?           @relation("FatherOffspring", fields: [fatherId], references: [id], onDelete: SetNull)
  childrenAsMother Dog[]          @relation("MotherOffspring")
  childrenAsFather Dog[]          @relation("FatherOffspring")
  littersAsDam     Litter[]       @relation("DamLitters")
  littersAsSire    Litter[]       @relation("SireLitters")
  healthRecords    HealthRecord[]
  puppyLink        Puppy?

  @@index([status])
  @@index([callName])
  @@index([breed])
}

model Litter {
  id           String    @id @default(cuid())
  name         String?
  breedType    String? // Mini Golden Doodle | Micro Golden Doodle | Mini Bernedoodle | Micro Bernedoodle | Munchkin Bernedoodle
  damId        String
  sireId       String
  whelpDate    DateTime?
  expectedDate DateTime?
  notes        String?
  status       String    @default("PLANNED") // PLANNED | EXPECTING | BORN | CLOSED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  dam          Dog             @relation("DamLitters", fields: [damId], references: [id])
  sire         Dog             @relation("SireLitters", fields: [sireId], references: [id])
  puppies      Puppy[]
  reservations Reservation[]
  contracts    Contract[]
  coiChecks    MatingCoiCheck[]
}

model Puppy {
  id                   String   @id @default(cuid())
  litterId             String
  /// Original / temporary litter name (e.g. "Pup D", "Honey")
  tempName             String
  /// Name we start calling them (given / call name)
  callName             String?
  sex                  String? // MALE | FEMALE
  color                String?
  status               String   @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | KEPT
  pickPosition         Int?
  dogId                String?  @unique
  /// Picker customer (synced from reservation when linked; manual override allowed)
  customerId           String?
  wantsSnugglePuppy    Boolean  @default(false)
  /// Travel docs / travel bag / travel arrangements
  wantsTravelDocuments Boolean  @default(false)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  litter      Litter       @relation(fields: [litterId], references: [id], onDelete: Cascade)
  dog         Dog?         @relation(fields: [dogId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation Reservation?

  @@index([customerId])
  @@index([litterId])
}

model Customer {
  id                   String   @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  address              String? // free-form full address
  street               String?
  city                 String?
  state                String?
  zip                  String?
  notes                String?
  /// Preferred DocuSign template: goldendoodle | bernedoodle
  docusignTemplateKey  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  reservations Reservation[]
  contracts    Contract[]
  puppies      Puppy[]

  @@index([name])
  @@index([email])
  @@index([phone])
}

model Reservation {
  id                   String   @id @default(cuid())
  litterId             String
  puppyId              String?  @unique
  customerId           String?
  // Legacy buyer fields kept for old rows / denormalized display
  buyerName            String?
  buyerEmail           String?
  buyerPhone           String?
  depositAmount        Float
  paymentMethod        String? // CASH | CHECK | VENMO | ZELLE | OTHER
  paidWhere            String?
  paid                 Boolean  @default(false)
  pickPosition         Int?
  status               String   @default("OPEN") // OPEN | COMPLETED | CANCELLED | REFUNDED
  notes                String?
  // Add-ons / fees
  snugglePuppy         Boolean  @default(false)
  snugglePuppyAmount   Float?
  travelBag            Boolean  @default(false)
  travelBagAmount      Float?
  travelArrangements   Boolean  @default(false)
  travelArrangementsNotes  String?
  travelArrangementsAmount Float?
  customFeesJson       String? // JSON: [{label, amount}]
  feesTotal            Float? // cached deposit + selected fees
  docusignEnvelopeId   String?
  docusignStatus       String? // DRAFT | SENT_MOCK | CONFIGURED_PENDING
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  litter     Litter     @relation(fields: [litterId], references: [id], onDelete: Cascade)
  puppy      Puppy?     @relation(fields: [puppyId], references: [id], onDelete: SetNull)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  inquiries  Inquiry[]
  contracts  Contract[]

  @@index([customerId])
  @@index([status])
}

model Contract {
  id                   String   @id @default(cuid())
  customerId           String
  reservationId        String?
  litterId             String?
  title                String
  status               String   @default("DRAFT") // DRAFT | SENT | SIGNED | CANCELLED
  depositAmount        Float    @default(0)
  feesJson             String? // JSON snapshot of fee lines + add-ons
  totalAmount          Float    @default(0)
  notes                String?
  docusignEnvelopeId   String?
  docusignStatus       String?
  /// goldendoodle | bernedoodle (explicit pick, not breed auto-map)
  docusignTemplateKey  String?
  docusignTemplateId   String?
  /// JSON of mirrored contract field values sent to DocuSign
  templateFieldsJson   String?
  sentAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  litter      Litter?      @relation(fields: [litterId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
}

model HealthRecord {
  id         String    @id @default(cuid())
  dogId      String
  title      String
  notes      String?
  recordDate DateTime  @default(now())
  followUpAt DateTime?
  filePath   String?
  fileName   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
  @@index([followUpAt])
}

model MatingCoiCheck {
  id              String    @id @default(cuid())
  litterId        String?
  damId           String
  sireId          String
  coiPercent      Float
  generations     Int
  commonAncestors String // JSON
  highRelatedness Boolean
  confirmed       Boolean   @default(false)
  confirmedBy     String?
  confirmedAt     DateTime?
  warningMessage  String?
  createdAt       DateTime  @default(now())

  litter Litter? @relation(fields: [litterId], references: [id], onDelete: SetNull)
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Inquiry {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String?
  message       String?
  source        String   @default("manual")
  status        String   @default("NEW")
  externalId    String?  @unique
  rawPayload    String?
  reservationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([source])
}
