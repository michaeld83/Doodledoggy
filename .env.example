DATABASE_URL="file:../data/doodledoggy.db"
SESSION_SECRET="change-me-to-a-long-random-string"
COI_WARN_THRESHOLD="6.25"
COI_COMMON_ANCESTOR_GENS="4"
UPLOAD_DIR="./public/uploads"

# App public URL (used for Google OAuth redirect URI). Localhost is auto-detected in dev.
APP_BASE_URL="https://doodledoggy.vercel.app"

# Google OAuth (Sign in with Google) — leave blank until Cloud Console is set up
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated allowlist (normalized to lowercase). Defaults to the two kennel emails if unset.
GOOGLE_ALLOWED_EMAILS="michaeld83@gmail.com,christylee123@gmail.com"

# DocuSign (optional — leave MODE=mock for local mock sends)
DOCUSIGN_MODE="mock"
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_AUTH_SERVER="https://account-d.docusign.com"
DOCUSIGN_ACCOUNT_BASE_URI="https://demo.docusign.net"
# Prefer PEM string on Vercel (newlines as \n). Locally you can use a file path instead.
DOCUSIGN_PRIVATE_KEY=""
DOCUSIGN_PRIVATE_KEY_PATH="./secrets/docusign_private.key"
# Breed → DocuSign template (demo account defaults shown)
# Mini/Micro Golden Doodle → Goldendoodle; Mini/Micro/Munchkin Bernedoodle → Bernedoodle
DOCUSIGN_TEMPLATE_GOLDENDOODLE="cb1b6556-d557-4c96-bbae-db7553996865"
DOCUSIGN_TEMPLATE_BERNEDOODLE="9c858314-95a2-4e42-8b98-56e0b3c76bff"

# Website form / inquiry webhook
INQUIRY_WEBHOOK_SECRET="change-me-inquiry-webhook-secret"

# Free durable host (Vercel + Turso + Blob)
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
