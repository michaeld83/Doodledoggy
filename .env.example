DATABASE_URL="file:../data/doodledoggy.db"
SESSION_SECRET="change-me-to-a-long-random-string"
COI_WARN_THRESHOLD="6.25"
COI_COMMON_ANCESTOR_GENS="4"
UPLOAD_DIR="./public/uploads"

# DocuSign (optional — leave empty for mock mode)
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_USER_ID=""
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_AUTH_SERVER="https://account-d.docusign.com"
DOCUSIGN_PRIVATE_KEY_PATH="./secrets/docusign_private.key"
DOCUSIGN_MODE="mock"

# Website form / inquiry webhook
INQUIRY_WEBHOOK_SECRET="change-me-inquiry-webhook-secret"

